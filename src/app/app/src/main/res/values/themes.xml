<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AERIS" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/violeta</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AERIS" parent="Base.Theme.AERIS" />

    <!-- Etiqueta encima de cada campo -->
    <style name="AERIS.Etiqueta" parent="">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Campo de texto con fondo blanco y borde gris -->
    <style name="AERIS.Campo" parent="">
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/fondo_campo</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Mensaje de error debajo de un campo (oculto por defecto) -->
    <style name="AERIS.Error" parent="">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Opción del perfil: fila blanca de 46dp con borde (Figma: perfil) -->
    <style name="AERIS.Fila" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/fondo_fila</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Texto de la izquierda de una opción del perfil -->
    <style name="AERIS.FilaTexto" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Valor o flecha de la derecha de una opción del perfil -->
    <style name="AERIS.FilaFlecha" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">@string/flecha</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Pestaña de la barra de navegación inferior -->
    <style name="AERIS.Pestanya" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AERIS.PestanyaIcono" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="AERIS.PestanyaTexto" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Título de sección de «Información» (EL AIRE QUE RESPIRAS…), T009 -->
    <style name="AERIS.InfoSeccion" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nombre de cada pieza del sensor (Información, «Por dentro»), T009 -->
    <style name="AERIS.InfoPieza" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/texto_cuerpo</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Tarjetas de «Cómo llevarlo» (Información), T009 -->
    <style name="AERIS.InfoLlevar" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/fondo_tarjeta_info</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="AERIS.InfoLlevarImagen" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="AERIS.InfoLlevarTitulo" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AERIS.InfoLlevarTexto" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Fila de acceso de Inicio (Mejor hora para salir, Mis lugares), T006 -->
    <style name="AERIS.AccesoInicio" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fondo_tarjeta_inicio_pulsable</item>
        <item name="android:elevation">3dp</item>
        <item name="android:outlineAmbientShadowColor">@color/sombra_tarjeta</item>
        <item name="android:outlineSpotShadowColor">@color/sombra_tarjeta</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AERIS.AccesoInicioIcono" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/fondo_icono_acceso</item>
        <item name="android:padding">9dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="AERIS.AccesoInicioFlecha" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_flecha_derecha</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="AERIS.AccesoInicioTextos" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="AERIS.AccesoInicioTitulo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AERIS.AccesoInicioTexto" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Forma de círculo para la foto de perfil (ShapeableImageView) -->
    <style name="AERIS.FormaCirculo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
