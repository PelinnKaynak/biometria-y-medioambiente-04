<?xml version="1.0" encoding="utf-8"?>
<!-- Opción de «¿De qué trata?» del formulario de Ayuda: blanca con borde gris; la elegida
     (selected) va en lila con borde violeta. T043 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/info_lila_suave" />
            <stroke android:width="1.5dp" android:color="@color/violeta" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/blanco" />
            <stroke android:width="1dp" android:color="@color/borde_campo" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
