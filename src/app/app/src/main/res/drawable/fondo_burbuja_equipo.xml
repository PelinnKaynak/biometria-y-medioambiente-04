<?xml version="1.0" encoding="utf-8"?>
<!-- Mensaje del equipo (técnico o administrador) en la conversación de una incidencia:
     blanco con borde suave, a la izquierda. T043 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/blanco" />
    <stroke android:width="1dp" android:color="@color/borde_tarjeta" />
    <corners
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="16dp"
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp" />
</shape>
