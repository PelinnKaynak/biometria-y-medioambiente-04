<?xml version="1.0" encoding="utf-8"?>
<!-- Mapa mínimo de un aviso de contaminación (T008): zona, texto del aviso y mapa centrado -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    tools:context=".MapaAvisoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/botonVolverMapaAviso"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/aviso_mapa_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/fondo_tarjeta"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/textoZonaMapaAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textFontWeight="600"
            android:textSize="16sp"
            tools:text="Casa (Gandía)" />

        <TextView
            android:id="@+id/textoAvisoMapaAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="200 µg/m³ de ozono en Casa (Gandía)." />
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapaAviso"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/aviso_mapa_descripcion"
        android:minHeight="300dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:text="@string/mis_lugares_mapa_atribucion"
        android:textColor="@color/texto_secundario"
        android:textSize="11sp" />
</LinearLayout>
