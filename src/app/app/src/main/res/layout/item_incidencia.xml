<?xml version="1.0" encoding="utf-8"?>
<!-- Una incidencia de «Mis incidencias» (Ayuda): tipo, estado, asunto, un trozo del mensaje y la
     fecha. Al tocarla se abre su conversación. La rellena AyudaActivity. T043 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/fondo_tarjeta"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tipoIncidencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textColor="@color/texto_secundario"
            android:textFontWeight="600"
            android:textSize="11sp"
            tools:text="SENSOR" />

        <!-- «Con respuesta»: junto al estado, para que no se pegue al enlace de abajo -->
        <TextView
            android:id="@+id/conRespuestaIncidencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/ayuda_con_respuesta"
            android:textColor="@color/verde_ok"
            android:textFontWeight="600"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/estadoIncidencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_etiqueta_estado"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textFontWeight="600"
            android:textSize="11sp"
            tools:text="Abierta" />
    </LinearLayout>

    <TextView
        android:id="@+id/asuntoIncidencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/texto_principal"
        android:textFontWeight="600"
        android:textSize="16sp"
        tools:text="El sensor no conecta" />

    <TextView
        android:id="@+id/descripcionIncidencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:textColor="@color/texto_cuerpo"
        android:textSize="13sp"
        tools:text="La luz parpadea en azul y no consigo conectarlo con el móvil." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fechaIncidencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            tools:text="19 nov 2026 · 10:00" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/ayuda_ver_conversacion"
            android:textColor="@color/violeta"
            android:textFontWeight="600"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
