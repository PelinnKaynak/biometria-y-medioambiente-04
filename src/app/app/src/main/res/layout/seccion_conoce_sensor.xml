<?xml version="1.0" encoding="utf-8"?>
<!-- «Tu sensor AERIS» en «Información»: el sensor con sus partes señaladas, las piezas
     que se separan al bajar por la pantalla y cómo llevarlo. Las imágenes son
     renders del modelo 3D de la carcasa (aeris_assembly.glb). Las llamadas y la
     posición de las piezas las pone InformacionActivity. T009 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 1. El sensor con sus partes señaladas -->
    <FrameLayout
        android:id="@+id/tarjetaSensorFoto"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/fondo_tarjeta_sensor"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:text="@string/info_conoce_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Sombra en el suelo: se encoge cuando el sensor sube -->
        <View
            android:id="@+id/sombraSensor"
            android:layout_width="130dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/sombra_sensor" />

        <ImageView
            android:id="@+id/imagenSensor"
            android:layout_width="186dp"
            android:layout_height="246dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/info_conoce_descripcion"
            android:scaleType="fitCenter"
            android:src="@drawable/sensor_principal" />
    </FrameLayout>

    <!-- 2. Por dentro: las piezas se separan al bajar -->
    <LinearLayout
        android:id="@+id/tarjetaPiezas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/fondo_tarjeta_info"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/info_piezas_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/info_piezas_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/escenaPiezas"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/piezaCarcasa"
                android:layout_width="87dp"
                android:layout_height="121dp"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sensor_pieza_carcasa" />

            <ImageView
                android:id="@+id/piezaModulo"
                android:layout_width="42dp"
                android:layout_height="54dp"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sensor_pieza_modulo" />

            <ImageView
                android:id="@+id/piezaFiltro"
                android:layout_width="53dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sensor_pieza_filtro" />

            <ImageView
                android:id="@+id/piezaTapa"
                android:layout_width="80dp"
                android:layout_height="95dp"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sensor_pieza_tapa" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/etiquetasPiezas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:orientation="horizontal">

            <TextView style="@style/AERIS.InfoPieza" android:text="@string/info_pieza_tapa" />
            <TextView style="@style/AERIS.InfoPieza" android:text="@string/info_pieza_filtro" />
            <TextView style="@style/AERIS.InfoPieza" android:text="@string/info_pieza_modulo" />
            <TextView style="@style/AERIS.InfoPieza" android:text="@string/info_pieza_carcasa" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Cómo llevarlo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/info_llevar_titulo"
        android:textColor="@color/texto_principal"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/filaLlevar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout style="@style/AERIS.InfoLlevar" android:layout_marginEnd="8dp">
            <ImageView style="@style/AERIS.InfoLlevarImagen" android:src="@drawable/sensor_vista_detras" />
            <TextView style="@style/AERIS.InfoLlevarTitulo" android:text="@string/info_llevar_clip" />
            <TextView style="@style/AERIS.InfoLlevarTexto" android:text="@string/info_llevar_clip_texto" />
        </LinearLayout>

        <LinearLayout style="@style/AERIS.InfoLlevar" android:layout_marginEnd="8dp">
            <ImageView style="@style/AERIS.InfoLlevarImagen" android:src="@drawable/sensor_vista_tres_cuartos" />
            <TextView style="@style/AERIS.InfoLlevarTitulo" android:text="@string/info_llevar_anilla" />
            <TextView style="@style/AERIS.InfoLlevarTexto" android:text="@string/info_llevar_anilla_texto" />
        </LinearLayout>

        <LinearLayout style="@style/AERIS.InfoLlevar">
            <ImageView style="@style/AERIS.InfoLlevarImagen" android:src="@drawable/sensor_vista_frente" />
            <TextView style="@style/AERIS.InfoLlevarTitulo" android:text="@string/info_llevar_rejilla" />
            <TextView style="@style/AERIS.InfoLlevarTexto" android:text="@string/info_llevar_rejilla_texto" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
