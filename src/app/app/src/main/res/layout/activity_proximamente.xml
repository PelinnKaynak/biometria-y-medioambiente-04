<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla PROVISIONAL de una sección aún no hecha (Mapa, Mis datos,
     Previsión, Mis lugares) · T006 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ProximamenteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tituloSeccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Mapa" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <ImageView
                android:id="@+id/iconoSeccion"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/fondo_icono_acceso"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:tint="@color/violeta"
                tools:src="@drawable/ic_mapa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/fondo_etiqueta_ejemplo"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/proximamente_etiqueta"
                android:textColor="@color/violeta"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/texto_cuerpo"
                android:textSize="14sp"
                tools:text="Aquí verás el mapa de la calidad del aire de tu ciudad." />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/barra_navegacion" />
</LinearLayout>
