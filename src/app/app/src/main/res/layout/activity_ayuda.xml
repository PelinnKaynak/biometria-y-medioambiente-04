<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla «Ayuda» (T043): preguntas frecuentes, formulario para enviar una incidencia y
     «Mis incidencias». Estructura como «Editar mis datos»; las tarjetas de las preguntas
     (item_tema_informacion.xml) y las de la lista (item_incidencia.xml) las añade AyudaActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollAyuda"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".AyudaActivity">

    <LinearLayout
        android:id="@+id/contenidoAyuda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/ayuda_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/ayuda_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <!-- 1. Preguntas frecuentes -->
        <TextView
            style="@style/AERIS.InfoSeccion"
            android:text="@string/ayuda_seccion_faq"
            android:textColor="@color/info_verde_icono" />

        <LinearLayout
            android:id="@+id/temasFaq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 2. Enviar una incidencia -->
        <TextView
            style="@style/AERIS.InfoSeccion"
            android:text="@string/ayuda_seccion_formulario"
            android:textColor="@color/violeta" />

        <LinearLayout
            android:id="@+id/tarjetaFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/ayuda_formulario_texto"
                android:textColor="@color/texto_cuerpo"
                android:textSize="14sp" />

            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ayuda_tipo_etiqueta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSensor"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_chip_tipo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ayuda_tipo_sensor"
                    android:textColor="@color/texto_principal"
                    android:textFontWeight="600"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipDatos"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_chip_tipo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ayuda_tipo_datos"
                    android:textColor="@color/texto_principal"
                    android:textFontWeight="600"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCuenta"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_chip_tipo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ayuda_tipo_cuenta"
                    android:textColor="@color/texto_principal"
                    android:textFontWeight="600"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipOtra"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_chip_tipo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ayuda_tipo_otra"
                    android:textColor="@color/texto_principal"
                    android:textFontWeight="600"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Sensor preseleccionado: solo si se llega desde Mi sensor y el tipo es sensor o mediciones -->
            <TextView
                android:id="@+id/lineaSensor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fondo_linea_sensor"
                android:padding="10dp"
                android:textColor="@color/violeta_oscuro"
                android:textFontWeight="500"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Sensor: Sensor AERIS · 092021010920"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/errorTipo"
                style="@style/AERIS.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ayuda_asunto_etiqueta" />

            <EditText
                android:id="@+id/campoAsunto"
                style="@style/AERIS.Campo"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="@string/ayuda_asunto_pista"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="120" />

            <TextView
                android:id="@+id/errorAsunto"
                style="@style/AERIS.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ayuda_descripcion_etiqueta" />

            <EditText
                android:id="@+id/campoDescripcion"
                style="@style/AERIS.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/ayuda_descripcion_pista"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="2000"
                android:minHeight="120dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:singleLine="false" />

            <TextView
                android:id="@+id/errorDescripcion"
                style="@style/AERIS.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/errorFormulario"
                style="@style/AERIS.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/avisoEnviada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/fondo_aviso_ok"
                android:lineSpacingMultiplier="1.15"
                android:padding="12dp"
                android:text="@string/ayuda_enviada"
                android:textColor="@color/verde_ok"
                android:textFontWeight="500"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/botonEnviar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/ayuda_enviar"
                android:textColor="@color/blanco"
                android:textFontWeight="600"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 3. Mis incidencias -->
        <TextView
            style="@style/AERIS.InfoSeccion"
            android:text="@string/ayuda_seccion_mis_incidencias" />

        <ProgressBar
            android:id="@+id/progresoIncidencias"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/violeta" />

        <TextView
            android:id="@+id/textoListaIncidencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/texto_cuerpo"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Aún no has enviado ninguna incidencia." />

        <TextView
            android:id="@+id/botonReintentarLista"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_boton_secundario"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/ayuda_reintentar"
            android:textColor="@color/violeta"
            android:textFontWeight="600"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/listaIncidencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
