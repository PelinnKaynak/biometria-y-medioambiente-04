<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla «Previsión de ozono» de las próximas 48 horas (T032).
     Estructura como «Editar mis datos»: ScrollView, botón volver, título y tarjetas blancas.
     Estados: cargando / error (tarjetaEstado) o datos (contenidoPrevision). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".PrevisionActivity">

    <LinearLayout
        android:id="@+id/columnaPrevision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/prevision_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtituloPrevision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            tools:text="Gandia · próximas 48 horas" />

        <!-- Cargando o error -->
        <LinearLayout
            android:id="@+id/tarjetaEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_tarjeta"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/progresoPrevision"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="@color/violeta" />

            <TextView
                android:id="@+id/textoEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/prevision_cargando"
                android:textColor="@color/texto_cuerpo"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/botonReintentar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_boton_secundario"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/prevision_reintentar"
                android:textColor="@color/violeta"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Datos -->
        <LinearLayout
            android:id="@+id/contenidoPrevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Aviso de datos simulados: no se oculta mientras la API los marque como simulados -->
            <LinearLayout
                android:id="@+id/avisoSimulado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_aviso_simulado"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/aviso_simulado" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prevision_aviso_titulo"
                        android:textColor="@color/aviso_simulado"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textoAviso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/aviso_simulado"
                        android:textSize="13sp"
                        tools:text="Datos históricos desplazados temporalmente para pruebas. No es una previsión basada en mediciones actuales." />
                </LinearLayout>
            </LinearLayout>

            <!-- Pico y mejor momento (se apilan en pantallas estrechas, ver PrevisionActivity) -->
            <LinearLayout
                android:id="@+id/filaResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tarjetaPico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_tarjeta"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/AERIS.InfoSeccion"
                        android:layout_marginTop="0dp"
                        android:text="@string/prevision_pico_titulo" />

                    <TextView
                        android:id="@+id/valorPico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="87 µg/m³" />

                    <TextView
                        android:id="@+id/horaPico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/texto_cuerpo"
                        android:textSize="13sp"
                        tools:text="Mañana a las 15:00" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/puntoPico"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/fondo_punto_nivel" />

                        <TextView
                            android:id="@+id/nivelPico"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/texto_principal"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Bueno" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tarjetaMejor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_tarjeta"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/AERIS.InfoSeccion"
                        android:layout_marginTop="0dp"
                        android:text="@string/prevision_mejor_titulo"
                        android:textColor="@color/info_verde_icono" />

                    <TextView
                        android:id="@+id/franjaMejor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Mañana 07:00–09:00" />

                    <TextView
                        android:id="@+id/mediaMejor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/texto_cuerpo"
                        android:textSize="13sp"
                        tools:text="Media 47 µg/m³ · Bueno" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/prevision_orientativo"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gráfica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_tarjeta"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/AERIS.InfoSeccion"
                    android:layout_marginTop="0dp"
                    android:text="@string/prevision_grafica_titulo" />

                <TextView
                    android:id="@+id/seleccionGrafica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="36dp"
                    android:text="@string/prevision_grafica_ayuda"
                    android:textColor="@color/texto_cuerpo"
                    android:textSize="13sp" />

                <com.example.aeris.GraficaPrevision
                    android:id="@+id/grafica"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Leyenda de niveles (item_nivel_ozono.xml, como en Información) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_tarjeta"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/AERIS.InfoSeccion"
                    android:layout_marginTop="0dp"
                    android:text="@string/prevision_leyenda_titulo" />

                <LinearLayout
                    android:id="@+id/leyendaNiveles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/pieModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/texto_terciario"
                android:textSize="11sp"
                tools:text="Modelo: hist_gradient_boosting_ozono_48h.joblib" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
