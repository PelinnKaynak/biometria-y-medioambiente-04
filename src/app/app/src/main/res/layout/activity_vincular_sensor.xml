<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla «Vincular sensor» (Figma: vincular sensor). Diseño de T005 (H019):
     la búsqueda por Bluetooth y la petición al servidor las completa T005. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".VincularSensorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="27dp"
        android:paddingTop="24dp"
        android:paddingEnd="27dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/vincular_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vincular_texto"
            android:textColor="@color/texto_principal"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/botonBuscar"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_boton_principal"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/vincular_buscar"
            android:textColor="@color/blanco"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Estado de la búsqueda: buscando… / no se ha encontrado ninguno -->
        <LinearLayout
            android:id="@+id/estadoBusqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progresoBusqueda"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/violeta" />

            <TextView
                android:id="@+id/textoEstadoBusqueda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                tools:text="@string/vincular_buscando" />
        </LinearLayout>

        <!-- Lista de sensores encontrados (la rellena mostrarSensores()) -->
        <TextView
            android:id="@+id/tituloEncontrados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/vincular_encontrados"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/listaSensores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/enlaceOmitir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:padding="6dp"
            android:text="@string/vincular_omitir"
            android:textColor="@color/violeta"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoMasTarde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/vincular_mas_tarde"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
