<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla «Vincular sensor» (Figma: vincular sensor). T005 (H019): se escanea
     con la cámara el código de la etiqueta del sensor y se vincula a la cuenta. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".VincularSensorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="27dp"
        android:paddingTop="24dp"
        android:paddingEnd="27dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/vincular_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoVincular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vincular_texto"
            android:textColor="@color/texto_principal"
            android:textSize="14sp" />

        <!-- Paso 1: escanear el código de la etiqueta -->
        <LinearLayout
            android:id="@+id/tarjetaEscanear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/fondo_tarjeta"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_escanear_codigo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/vincular_donde_codigo"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/botonEscanear"
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camara" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/vincular_escanear"
                    android:textColor="@color/blanco"
                    android:textSize="16sp"
                    android:textFontWeight="600" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorEscaneo"
                style="@style/AERIS.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/enlaceAMano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="6dp"
                android:text="@string/vincular_enlace_a_mano"
                android:textColor="@color/violeta"
                android:textSize="13sp"
                android:textFontWeight="600" />
        </LinearLayout>

        <!-- Si la cámara no funciona: la línea de números de la etiqueta escrita a mano -->
        <LinearLayout
            android:id="@+id/tarjetaAMano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vincular_a_mano_texto"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vincular_codigo_etiqueta" />

            <EditText
                android:id="@+id/campoCodigo"
                style="@style/AERIS.Campo"
                android:layout_width="match_parent"
                android:digits="0123456789,.- "
                android:fontFamily="monospace"
                android:hint="@string/vincular_codigo_pista"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLength="40"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/errorCodigo"
                style="@style/AERIS.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/botonContinuar"
                android:layout_width="180dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/vincular_continuar"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/enlaceVolverEscanear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:padding="6dp"
                android:text="@string/vincular_volver_escanear"
                android:textColor="@color/violeta"
                android:textSize="13sp"
                android:textFontWeight="600" />
        </LinearLayout>

        <!-- Paso 2: el sensor leído y el botón «Vincular» -->
        <LinearLayout
            android:id="@+id/tarjetaSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_aviso_ok"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/vincular_leido"
                    android:textColor="@color/verde_ok"
                    android:textSize="13sp"
                    android:textFontWeight="600" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vincular_numero_serie"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textoNumeroSerie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textFontWeight="500"
                android:textColor="@color/texto_principal"
                android:textSize="20sp"
                tools:text="092021010920" />

            <TextView
                android:id="@+id/textoDetalleSensor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Sensor de ozono (O₃) · fabricado en 09/2021" />

            <TextView
                android:id="@+id/botonVincular"
                android:layout_width="180dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/vincular_boton"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textFontWeight="600" />

            <!-- La vinculación se confirma por correo (Figma: «código leído») -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/vincular_nota_correo"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/errorVincular"
                style="@style/AERIS.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/enlaceEscanearOtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:padding="6dp"
                android:text="@string/vincular_escanear_otro"
                android:textColor="@color/violeta"
                android:textSize="13sp"
                android:textFontWeight="600" />
        </LinearLayout>

        <!-- Paso 3: esperando a que quien compró el sensor confirme por correo
             (Figma: «vincular sensor · esperando confirmación») -->
        <LinearLayout
            android:id="@+id/tarjetaEsperando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_aviso_espera"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/fondo_circulo_paso"
                        android:backgroundTint="@color/espera_icono"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="@color/blanco"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/vincular_esperando_titulo"
                        android:textColor="@color/espera_texto"
                        android:textSize="16sp"
                        android:textFontWeight="600" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textoEsperando"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/texto_cuerpo"
                    android:textSize="14sp"
                    tools:text="Hemos enviado un correo a m•••••@gmail.com, el correo con el que se compró el sensor 092021010920. Cuando lo confirme, tu sensor empezará a funcionar. El enlace caduca en 48 horas." />

                <TextView
                    android:id="@+id/botonReenviar"
                    android:layout_width="170dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_boton_secundario"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/vincular_reenviar"
                    android:textColor="@color/violeta"
                    android:textSize="16sp"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/textoReenviado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texto_cuerpo"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="@string/vincular_reenviado" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_tarjeta"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vincular_estado_titulo"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textFontWeight="600" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/fondo_circulo_paso"
                    android:backgroundTint="@color/verde_ok_fondo"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/verde_ok"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vincular_paso_escaneado"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textFontWeight="600" />

                    <TextView
                        android:id="@+id/textoPasoEscaneado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="092021010920 · hoy, 18:40"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/fondo_circulo_paso"
                    android:backgroundTint="@color/violeta"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/blanco"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vincular_paso_correo"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textFontWeight="600" />

                    <TextView
                        android:id="@+id/textoPasoCorreo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="Pendiente · m•••••@gmail.com"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/fondo_circulo_paso"
                    android:backgroundTint="@color/info_lila_suave"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/violeta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vincular_paso_vinculado"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textFontWeight="600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/vincular_paso_vinculado_detalle"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/vincular_esperando_nota"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/enlaceAyudaEsperando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:padding="6dp"
                android:text="@string/vincular_ayuda"
                android:textColor="@color/violeta"
                android:textSize="14sp"
                android:textFontWeight="600" />
        </LinearLayout>

        <!-- Si quien compró el sensor la rechaza o el enlace caduca
             (Figma: «vincular sensor · vinculación rechazada») -->
        <LinearLayout
            android:id="@+id/tarjetaRechazada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_aviso_rechazo"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/fondo_circulo_paso"
                        android:backgroundTint="@color/rechazo_icono"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/blanco"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/vincular_rechazada_titulo"
                        android:textColor="@color/rechazo_texto"
                        android:textSize="16sp"
                        android:textFontWeight="600" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/vincular_rechazada_texto"
                    android:textColor="@color/texto_cuerpo"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/botonEscanearDeNuevo"
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/vincular_escanear_de_nuevo"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/enlaceAyudaRechazada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:padding="6dp"
                android:text="@string/vincular_ayuda_error"
                android:textColor="@color/violeta"
                android:textSize="14sp"
                android:textFontWeight="600" />
        </LinearLayout>

        <!-- Solo después del registro: seguir sin sensor (no está en Figma) -->
        <TextView
            android:id="@+id/enlaceMasTarde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/vincular_mas_tarde"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
