<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla provisional de vincular sensor. Se completa en la tarea T005 (H019) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="27dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="@string/vincular_titulo"
        android:textColor="@color/texto_principal"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vincular_texto"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/enlaceOmitir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:padding="8dp"
        android:text="@string/vincular_omitir"
        android:textColor="@color/violeta"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
