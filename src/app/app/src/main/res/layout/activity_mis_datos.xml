<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MisDatosActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mis_datos_titulo"
                android:textColor="@color/texto_principal"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fechaMisDatos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/violeta"
                android:textSize="14sp"
                tools:text="Hoy, jueves 29 de octubre" />

            <ProgressBar
                android:id="@+id/progresoMisDatos"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/errorPanelMisDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorMisDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error"
                    android:textSize="14sp"
                    tools:text="No hay conexión con el servidor." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonReintentarMisDatos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/inicio_reintentar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenidoMisDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_tarjeta"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mis_datos_distancia"
                            android:textColor="@color/texto_cuerpo"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/valorDistanciaMisDatos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/texto_principal"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="4,2 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_tarjeta"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mis_datos_calidad_media"
                            android:textColor="@color/texto_cuerpo"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/valorCalidadMediaMisDatos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/nivel_bueno"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Buena" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/avisoSinMedicionesMisDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mis_datos_hoy_sin_mediciones"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/fondo_tarjeta"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mis_datos_ozono_hoy"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.example.aeris.GraficaDatosDiariosView
                        android:id="@+id/graficaMisDatos"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sinSensorMisDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_tarjeta"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/mis_datos_sin_sensor"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonVincularMisDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mi_sensor_vincular" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_navegacion" />
</LinearLayout>
