<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio PROVISIONAL (hasta T006): saludo y cerrar sesión -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="27dp"
    tools:context=".InicioActivity">

    <TextView
        android:id="@+id/saludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:textColor="@color/texto_principal"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/inicio_texto"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/botonCerrarSesion"
        android:layout_width="260dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:background="@drawable/fondo_boton_secundario"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/inicio_cerrar_sesion"
        android:textColor="@color/violeta"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
