<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio (Figma: «inicio», «inicio (sin sensor)» e
     «inicio · notificaciones abiertas») · T006 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    tools:context=".InicioActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:requiresFadingEdge="none"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contenidoInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <!-- Bienvenido y campana de notificaciones -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="52dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inicio_titulo"
                            android:textColor="@color/texto_principal"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/inicio_subtitulo"
                            android:textColor="@color/texto_cuerpo"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/botonCampana"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|top"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/inicio_notificaciones"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iconoCampana"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_campana" />

                        <TextView
                            android:id="@+id/insigniaAvisos"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/fondo_insignia"
                            android:gravity="center"
                            android:textColor="@color/blanco"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="3"
                            tools:visibility="visible" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Calidad del aire ahora: arco con la medición elegida (la última) -->
                <LinearLayout
                    android:id="@+id/tarjetaCalidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/fondo_tarjeta_inicio"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="@color/sombra_tarjeta"
                    android:outlineSpotShadowColor="@color/sombra_tarjeta"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="20dp">

                    <!-- Título y, viendo una medición anterior, el botón «Ahora» -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tituloCalidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/inicio_calidad_titulo"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/botonAhora"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="end|center_vertical"
                            android:background="@drawable/fondo_etiqueta_ejemplo"
                            android:drawableStart="@drawable/ic_volver_ahora"
                            android:drawablePadding="3dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="10dp"
                            android:text="@string/inicio_ahora"
                            android:textColor="@color/violeta"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="132dp"
                        android:layout_marginTop="18dp">

                        <com.example.aeris.IndicadorCalidad
                            android:id="@+id/indicadorCalidad"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="46dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textoValor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/inicio_sin_valor"
                                android:textColor="@color/texto_principal"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textoNivel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-4dp"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="Buena" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progresoCalidad"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/violeta"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textoMensaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        tools:text="El aire es seguro para actividades al aire libre." />

                    <TextView
                        android:id="@+id/textoMomento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto_terciario"
                        android:textSize="11sp"
                        tools:text="Medido hace 4 min · 18:42" />

                    <!-- Aviso si la última medición tiene más de 1 hora (H006) -->
                    <LinearLayout
                        android:id="@+id/avisoAntigua"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/fondo_aviso_antigua"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_aviso" />

                        <TextView
                            android:id="@+id/textoAvisoAntigua"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/aviso_texto"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Error sin mediciones: mensaje y «Reintentar» -->
                    <LinearLayout
                        android:id="@+id/bloqueError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textoError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/error"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/botonReintentar"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/fondo_boton_pequeno"
                            android:foreground="@drawable/onda_boton_inicio"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="@string/inicio_reintentar"
                            android:textColor="@color/blanco"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Últimas mediciones: tocar una la enseña en el arco -->
                <LinearLayout
                    android:id="@+id/tarjetaUltimas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fondo_tarjeta_inicio"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="@color/sombra_tarjeta"
                    android:outlineSpotShadowColor="@color/sombra_tarjeta"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tituloUltimas"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/inicio_ultimas_zona"
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/botonVerMas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="4dp"
                            android:text="@string/inicio_ver_mas"
                            android:textColor="@color/texto_secundario"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/listaUltimas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Mi sensor (con sensor vinculado) -->
                <LinearLayout
                    android:id="@+id/tarjetaMiSensor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fondo_tarjeta_inicio"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="@color/sombra_tarjeta"
                    android:outlineSpotShadowColor="@color/sombra_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inicio_mi_sensor"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Punto de estado con un halo que late mientras llegan datos -->
                            <FrameLayout
                                android:layout_width="14dp"
                                android:layout_height="14dp">

                                <View
                                    android:id="@+id/haloEstadoSensor"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:alpha="0"
                                    android:background="@drawable/fondo_punto_nivel"
                                    android:backgroundTint="@color/nivel_bueno" />

                                <View
                                    android:id="@+id/puntoEstadoSensor"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/fondo_punto_nivel"
                                    android:backgroundTint="@color/nivel_bueno" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/textoEstadoSensor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="@color/texto_principal"
                                android:textSize="14sp"
                                tools:text="Conectado" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textoBateria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/texto_principal"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:text="Batería: 78 %"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/botonVerSensor"
                        android:layout_width="90dp"
                        android:layout_height="34dp"
                        android:background="@drawable/fondo_boton_pequeno"
                        android:foreground="@drawable/onda_boton_inicio"
                        android:gravity="center"
                        android:text="@string/inicio_ver"
                        android:textColor="@color/blanco"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sin sensor: tarjeta para vincularlo (Figma: inicio (sin sensor)) -->
                <LinearLayout
                    android:id="@+id/tarjetaVincular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fondo_tarjeta_inicio"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="@color/sombra_tarjeta"
                    android:outlineSpotShadowColor="@color/sombra_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inicio_vincular_titulo"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/inicio_vincular_texto"
                            android:textColor="@color/texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/botonVincular"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/fondo_boton_pequeno"
                        android:foreground="@drawable/onda_boton_inicio"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/inicio_vincular"
                        android:textColor="@color/blanco"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Accesos: mejor hora para salir y mis lugares -->
                <LinearLayout
                    android:id="@+id/filaPrevision"
                    style="@style/AERIS.AccesoInicio"
                    android:layout_marginTop="16dp">

                    <LinearLayout style="@style/AERIS.AccesoInicioTextos">

                        <TextView
                            style="@style/AERIS.AccesoInicioTitulo"
                            android:text="@string/inicio_prevision_titulo" />

                        <TextView
                            android:id="@+id/textoPrevision"
                            style="@style/AERIS.AccesoInicioTexto"
                            android:text="@string/inicio_prevision_texto" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/flechaPrevision"
                        style="@style/AERIS.AccesoInicioFlecha" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/filaLugares"
                    style="@style/AERIS.AccesoInicio"
                    android:layout_marginTop="16dp">

                    <LinearLayout style="@style/AERIS.AccesoInicioTextos">

                        <TextView
                            style="@style/AERIS.AccesoInicioTitulo"
                            android:text="@string/inicio_lugares_titulo" />

                        <TextView
                            android:id="@+id/textoLugares"
                            style="@style/AERIS.AccesoInicioTexto"
                            android:text="@string/inicio_lugares_texto" />

                        <!-- Con datos: un punto del color del nivel por lugar -->
                        <LinearLayout
                            android:id="@+id/listaLugares"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/flechaLugares"
                        style="@style/AERIS.AccesoInicioFlecha" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/barra_navegacion" />
    </LinearLayout>

    <!-- Panel de notificaciones (Figma: inicio · notificaciones abiertas) -->
    <FrameLayout
        android:id="@+id/capaAvisos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/velo_avisos"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panelAvisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="82dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/fondo_panel_avisos"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inicio_notificaciones"
                android:textColor="@color/texto_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/listaAvisos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textoSinAvisos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/inicio_sin_notificaciones"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
