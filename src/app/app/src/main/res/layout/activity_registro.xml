<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de registro (Figma: «registrarte»). Tarea T002 · historia H001 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="27dp"
        android:paddingTop="24dp"
        android:paddingEnd="27dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/registro_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/registro_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <!-- Nombre y apellidos en la misma fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/AERIS.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registro_nombre" />

                <EditText
                    android:id="@+id/campoNombre"
                    style="@style/AERIS.Campo"
                    android:layout_width="match_parent"
                    android:autofillHints="givenName"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    android:id="@+id/errorNombre"
                    style="@style/AERIS.Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/AERIS.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registro_apellidos" />

                <EditText
                    android:id="@+id/campoApellidos"
                    style="@style/AERIS.Campo"
                    android:layout_width="match_parent"
                    android:autofillHints="familyName"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    android:id="@+id/errorApellidos"
                    style="@style/AERIS.Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/AERIS.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registro_correo" />

        <EditText
            android:id="@+id/campoCorreo"
            style="@style/AERIS.Campo"
            android:layout_width="match_parent"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress" />

        <TextView
            android:id="@+id/errorCorreo"
            style="@style/AERIS.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/AERIS.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registro_contrasena" />

        <EditText
            android:id="@+id/campoContrasena"
            style="@style/AERIS.Campo"
            android:layout_width="match_parent"
            android:autofillHints="newPassword"
            android:hint="@string/registro_contrasena_pista"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/errorContrasena"
            style="@style/AERIS.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/AERIS.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registro_confirmacion" />

        <EditText
            android:id="@+id/campoConfirmacion"
            style="@style/AERIS.Campo"
            android:layout_width="match_parent"
            android:autofillHints="newPassword"
            android:hint="@string/registro_confirmacion_pista"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/errorConfirmacion"
            style="@style/AERIS.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Error general (por ejemplo, sin conexión con el servidor) -->
        <TextView
            android:id="@+id/errorGeneral"
            style="@style/AERIS.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/botonContinuar"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="26dp"
            android:background="@drawable/fondo_boton_principal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/registro_continuar"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/violeta"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/registro_ya_tienes_cuenta"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/enlaceIniciarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/registro_inicia_sesion"
                android:textColor="@color/violeta"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
