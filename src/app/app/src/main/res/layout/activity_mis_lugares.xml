<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla «Mis lugares» (T019 · H034).
     Permite guardar hasta 5 lugares habituales del usuario con nombre y dirección,
     muestra el nivel de ozono actual (del mapa interpolado) y permite activar o
     desactivar avisos para cada ubicación. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".MisLugaresActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Botón volver -->
        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <!-- Título y subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/mis_lugares_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mis_lugares_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <!-- Tarjeta de límite / contador -->
        <LinearLayout
            android:id="@+id/tarjetaContadorLugares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/violeta" />

                <TextView
                    android:id="@+id/textoContadorLugares"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="2 de 5 lugares guardados" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoAvisoLimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mis_lugares_error_limite"
                android:textColor="@color/error"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Tarjeta: Añadir nuevo lugar -->
        <LinearLayout
            android:id="@+id/tarjetaAnadirLugar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mis_lugares_anadir_titulo"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Campo Nombre -->
            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/mis_lugares_campo_nombre" />

            <EditText
                android:id="@+id/campoNombreLugar"
                style="@style/AERIS.Campo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/mis_lugares_campo_nombre"
                android:inputType="textCapWords" />

            <!-- Campo Dirección -->
            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mis_lugares_campo_direccion" />

            <EditText
                android:id="@+id/campoDireccionLugar"
                style="@style/AERIS.Campo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/mis_lugares_campo_direccion"
                android:inputType="textPostalAddress" />

            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mis_lugares_campo_tipo" />

            <Spinner
                android:id="@+id/campoTipoLugar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/mis_lugares_tipos_etiquetas" />

            <TextView
                style="@style/AERIS.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mis_lugares_campo_ubicacion" />

            <TextView
                android:id="@+id/botonSeleccionarUbicacion"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/mis_lugares_boton_seleccionar_mapa"
                android:textColor="@color/blanco"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textoUbicacionSeleccionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mis_lugares_ubicacion_pendiente"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="38.96700, -0.18300" />

            <TextView
                android:id="@+id/errorAnadirLugar"
                style="@style/AERIS.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Escribe un nombre para el lugar"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/botonGuardarLugar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/mis_lugares_boton_guardar"
                android:textColor="@color/blanco"
                android:textFontWeight="600"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Título de sección de la lista -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:text="Tus lugares guardados"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Mensaje de error general -->
        <TextView
            android:id="@+id/errorMisLugares"
            style="@style/AERIS.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            tools:visibility="gone" />

        <!-- Lista dinámica de tarjetas de lugares -->
        <LinearLayout
            android:id="@+id/listaLugares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Estado vacío cuando no hay lugares -->
        <LinearLayout
            android:id="@+id/tarjetaSinLugares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lugar"
                app:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/mis_lugares_sin_lugares"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/mis_lugares_sin_lugares_desc"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
