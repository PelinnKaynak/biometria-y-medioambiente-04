<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio de sesión (Figma: «login»). Tarea T003 · historia H002.
     «Entrar con huella» no está: no entra en este sprint. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="27dp"
        android:paddingTop="24dp"
        android:paddingEnd="27dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <ImageView
            android:layout_width="160dp"
            android:layout_height="174dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:contentDescription="@string/logo_descripcion"
            android:src="@drawable/logo_aeris" />

        <!-- Correo -->
        <LinearLayout
            android:id="@+id/marcoCorreo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/fondo_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_correo" />

            <EditText
                android:id="@+id/campoCorreo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:hint="@string/login_correo_pista"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorCorreo"
            style="@style/AERIS.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Contraseña con el ojo para verla -->
        <LinearLayout
            android:id="@+id/marcoContrasena"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_candado" />

            <EditText
                android:id="@+id/campoContrasena"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints="password"
                android:background="@null"
                android:hint="@string/login_contrasena_pista"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/botonVerContrasena"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/login_ver_contrasena"
                android:padding="10dp"
                android:src="@drawable/ic_ocultar_contrasena" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorContrasena"
            style="@style/AERIS.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/enlaceRecuperar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:padding="4dp"
            android:text="@string/login_recuperar"
            android:textColor="@color/violeta"
            android:textSize="12sp"
            android:textFontWeight="600" />

        <!-- Error general: «Correo o contraseña incorrectos», sin conexión… -->
        <TextView
            android:id="@+id/errorGeneral"
            style="@style/AERIS.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/botonAcceder"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/fondo_boton_principal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/login_acceder"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textFontWeight="600" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/violeta"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_tienes_cuenta"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/enlaceRegistrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/login_registrate"
                android:textColor="@color/violeta"
                android:textSize="14sp"
                android:textFontWeight="600" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
