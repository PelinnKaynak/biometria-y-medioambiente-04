<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla «Recuperar contraseña» (Figma). Tarea T003 · historia H002 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".RecuperarContrasenaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="27dp"
        android:paddingTop="24dp"
        android:paddingEnd="27dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/botonVolver"
            android:layout_width="105dp"
            android:layout_height="36dp"
            android:layout_marginStart="11dp"
            android:background="@drawable/fondo_boton_volver"
            android:gravity="center"
            android:text="@string/volver"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/recuperar_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recuperar_texto"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <TextView
            style="@style/AERIS.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/recuperar_correo" />

        <EditText
            android:id="@+id/campoCorreo"
            style="@style/AERIS.Campo"
            android:layout_width="match_parent"
            android:autofillHints="emailAddress"
            android:hint="@string/recuperar_correo_pista"
            android:inputType="textEmailAddress" />

        <TextView
            android:id="@+id/errorCorreo"
            style="@style/AERIS.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/errorGeneral"
            style="@style/AERIS.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/botonEnviar"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/fondo_boton_principal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/recuperar_enviar"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/violeta"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
