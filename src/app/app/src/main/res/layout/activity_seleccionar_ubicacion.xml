<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    tools:context=".SeleccionarUbicacionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/botonVolverMapaLugar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:id="@+id/textoTituloMapaLugar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/texto_principal"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:text="Elegir posición" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:text="@string/mis_lugares_mapa_instruccion"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <org.osmdroid.views.MapView
        android:id="@+id/mapaSeleccionUbicacion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/mis_lugares_mapa_instruccion"
        android:minHeight="300dp" />

    <TextView
        android:id="@+id/textoPosicionMapaLugar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/fondo_tarjeta"
        android:padding="12dp"
        android:text="@string/mis_lugares_mapa_sin_seleccion"
        android:textColor="@color/texto_principal"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/atribucionMapaLugar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:text="@string/mis_lugares_mapa_atribucion"
        android:textColor="@color/texto_secundario"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/botonConfirmarUbicacion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/fondo_boton_principal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/mis_lugares_mapa_confirmar"
        android:textColor="@color/blanco"
        android:textSize="15sp" />
</LinearLayout>
