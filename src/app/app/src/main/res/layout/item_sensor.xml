<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de «Sensores encontrados» (Figma: vincular sensor · fila Sensor). T005 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/fondo_fila"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/fondo_circulo_correo">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bluetooth" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textoNombreSensor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="500"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            tools:text="AERIS N-0412" />

        <TextView
            android:id="@+id/textoDetalleSensor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            tools:text="Señal fuerte · a 0,5 m" />
    </LinearLayout>

    <TextView
        android:id="@+id/botonVincular"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/fondo_boton_pequeno"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/vincular_boton"
        android:textColor="@color/blanco"
        android:textSize="16sp"
        android:textFontWeight="600" />
</LinearLayout>
