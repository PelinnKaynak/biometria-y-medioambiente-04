<?xml version="1.0" encoding="utf-8"?>
<!-- Conversación de una incidencia (T043): lo que escribió el usuario, las respuestas del equipo y la
     caja para seguir escribiendo. Los mensajes (item_mensaje.xml) los añade IncidenciaActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".IncidenciaActivity">

    <!-- Cabecera: volver, asunto, tipo, estado y fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_volver"
            android:clickable="true"
            android:contentDescription="@string/volver_descripcion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:id="@+id/asuntoIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="El sensor no conecta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tipoIncidencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:textColor="@color/texto_secundario"
                android:textFontWeight="600"
                android:textSize="11sp"
                tools:text="SENSOR" />

            <TextView
                android:id="@+id/estadoIncidencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/fondo_etiqueta_estado"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textFontWeight="600"
                android:textSize="11sp"
                tools:text="Abierta" />

            <TextView
                android:id="@+id/fechaIncidencia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                tools:text="19 nov 2026 · 10:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- La conversación -->
    <ScrollView
        android:id="@+id/scrollConversacion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/conversacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <ProgressBar
                android:id="@+id/progresoConversacion"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/violeta" />

            <TextView
                android:id="@+id/textoConversacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/texto_cuerpo"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Tu incidencia está siendo revisada por nuestro equipo técnico." />

            <TextView
                android:id="@+id/botonReintentarConversacion"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_boton_secundario"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/ayuda_reintentar"
                android:textColor="@color/violeta"
                android:textFontWeight="600"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Caja para escribir -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borde_campo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/errorMensaje"
            style="@style/AERIS.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="6dp"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/campoMensaje"
                style="@style/AERIS.Campo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="top|start"
                android:hint="@string/conversacion_mensaje_pista"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="2000"
                android:maxLines="4"
                android:minHeight="46dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:singleLine="false" />

            <TextView
                android:id="@+id/botonEnviarMensaje"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/fondo_boton_principal"
                android:clickable="true"
                android:contentDescription="@string/conversacion_enviar_descripcion"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/conversacion_enviar"
                android:textColor="@color/blanco"
                android:textFontWeight="600"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
