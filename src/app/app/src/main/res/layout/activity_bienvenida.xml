<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de bienvenida (Figma: «bienvenida»). Primera pantalla sin sesión. Tarea T001 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".BienvenidaActivity">

    <!-- Arriba: degradado con el logo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="52"
        android:background="@drawable/fondo_bienvenida"
        android:fitsSystemWindows="true">

        <ImageView
            android:layout_width="170dp"
            android:layout_height="185dp"
            android:layout_gravity="center"
            android:contentDescription="@string/logo_descripcion"
            android:src="@drawable/logo_aeris" />
    </FrameLayout>

    <!-- Abajo: título, texto, botones y enlace al mapa (oculto mientras se comprueba la sesión) -->
    <LinearLayout
        android:id="@+id/panelBienvenida"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="48"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/bienvenida_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/bienvenida_texto"
            android:textColor="@color/texto_principal"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/botonIniciarSesion"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/fondo_boton_principal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/bienvenida_iniciar_sesion"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/botonRegistrarte"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_boton_secundario"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/bienvenida_registrarte"
            android:textColor="@color/violeta"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/enlaceMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:padding="6dp"
            android:text="@string/bienvenida_ver_mapa"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
