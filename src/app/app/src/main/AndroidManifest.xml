<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17: permiso para conectar con el servidor en la red local -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AERIS"
        android:usesCleartextTraffic="true">

        <!-- Primera pantalla: la bienvenida (T001). Si ya hay sesión, abre directamente el inicio -->
        <activity
            android:name=".BienvenidaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MapaSinCuentaActivity"
            android:exported="false" />

        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RecuperarContrasenaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CorreoEnviadoActivity"
            android:exported="false" />

        <activity
            android:name=".InicioActivity"
            android:exported="false" />

        <activity
            android:name=".VincularSensorActivity"
            android:exported="false" />

        <!-- Perfil (T010): se abre desde la barra de navegación inferior -->
        <activity
            android:name=".PerfilActivity"
            android:exported="false" />

        <!-- Editar mis datos (T010): se abre desde el perfil -->
        <activity
            android:name=".EditarDatosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Mi sensor (T011): se abre desde el perfil -->
        <activity
            android:name=".MiSensorActivity"
            android:exported="false" />

        <!-- Comparte con la app de cámara el fichero donde guarda la foto de perfil (T010) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>

</manifest>
