<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Escáner propio del código de la etiqueta del sensor (T039) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Android 17: permiso para conectar con el servidor en la red local -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Recibir las mediciones del sensor por Bluetooth con la ubicación (T023) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Conectar con el sensor para cambiar su luz de aviso (H033, Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AERIS"
        android:usesCleartextTraffic="true">

        <!-- Primera pantalla: la bienvenida (T001). Si ya hay sesión, abre directamente el inicio -->
        <activity
            android:name=".BienvenidaActivity"
            android:theme="@style/Theme.AERIS.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pestaña «Info» de la barra de navegación (T009) -->
        <activity
            android:name=".InformacionActivity"
            android:exported="false" />

        <!-- Escáner del código de la etiqueta del sensor (T039) -->
        <activity
            android:name=".EscanerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MapaSinCuentaActivity"
            android:exported="false" />

        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RecuperarContrasenaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CorreoEnviadoActivity"
            android:exported="false" />

        <activity
            android:name=".InicioActivity"
            android:exported="false" />

        <!-- Mis datos (T007) se implementa en su pantalla propia. -->
        <activity
            android:name=".MisDatosActivity"
            android:exported="false" />

        <!-- Secciones aún no hechas: Mapa y Previsión (T006) -->
        <activity
            android:name=".ProximamenteActivity"
            android:exported="false" />

        <!-- Mis lugares (T019 · H034): gestión de lugares habituales y alertas -->
        <activity
            android:name=".MisLugaresActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SeleccionarUbicacionActivity"
            android:exported="false" />

        <!-- Mapa mínimo de un aviso del panel de notificaciones (T008) -->
        <activity
            android:name=".MapaAvisoActivity"
            android:exported="false" />

        <activity
            android:name=".VincularSensorActivity"
            android:exported="false" />

        <activity
            android:name=".MiSensorActivity"
            android:exported="false" />

        <!-- Ayuda (T043): preguntas frecuentes, enviar una incidencia y Mis incidencias.
             Se abre desde Perfil, Mi sensor y Vincular sensor -->
        <activity
            android:name=".AyudaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Conversación de una incidencia (T043): se abre desde Mis incidencias -->
        <activity
            android:name=".IncidenciaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Perfil (T010): se abre desde la barra de navegación inferior -->
        <activity
            android:name=".PerfilActivity"
            android:exported="false" />

        <!-- Editar mis datos (T010): se abre desde el perfil -->
        <activity
            android:name=".EditarDatosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Recibe las mediciones del sensor por Bluetooth y las envía al servidor (T023) -->
        <service
            android:name=".ServicioMediciones"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Comparte con la app de cámara el fichero donde guarda la foto de perfil (T010) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>

</manifest>
