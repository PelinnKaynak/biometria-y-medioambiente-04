# Opcional: copia este fichero como .env y cambia lo que haga falta.
# Sin .env el servidor usa estos mismos valores (MySQL de XAMPP).
# .env no se sube a GitHub (está en .gitignore).

# Puerto del servidor REST (la app usa http://10.0.2.2:8080 en el emulador)
PUERTO=8080

# MySQL de XAMPP
BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_USUARIO=root
BD_CONTRASENYA=
BD_NOMBRE=aeris

# Clave secreta para firmar los tokens de sesión y de recuperación.
# Pon un texto largo y aleatorio. Si cambia, todas las sesiones se cierran.
CLAVE_TOKENS=

# Página de la web que abre el enlace de recuperación de contraseña
URL_RESTABLECER=http://localhost:8080/restablecer.html

# Correo (SMTP) para enviar el enlace de recuperar contraseña.
# Si SMTP_HOST está vacío, el enlace se muestra en la consola del servidor
# en lugar de enviarse (útil para probar en local).
#
# Con Gmail (cuenta del equipo con verificación en dos pasos):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PUERTO=587
#   SMTP_USUARIO=cuenta@gmail.com
#   SMTP_CONTRASENYA=<contraseña de aplicación de 16 letras, NO la de la cuenta>
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENYA=
# Opcional; si se deja vacío se usa "AERIS <SMTP_USUARIO>"
SMTP_REMITENTE=
