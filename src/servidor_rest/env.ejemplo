# Opcional: copia este fichero como .env y cambia lo que haga falta.
# Sin .env el servidor usa estos mismos valores (MySQL de XAMPP).
# .env no se sube a GitHub (está en .gitignore).

# Puerto del servidor REST (la app usa http://10.0.2.2:8080 en el emulador)
PUERTO=8080

# Previsión de ozono (T032): GET /api/prevision/ozono. Pon 0 para desactivarla; entonces
# Python no se lanza nunca y la ruta responde 503. Sin esta línea está activa.
# El worker Python se lanza en la primera petición; PYTHON es el ejecutable (por defecto "python").
PREVISION_ACTIVA=1
# PYTHON=python

# MySQL de XAMPP
BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_USUARIO=root
BD_CONTRASENYA=
BD_NOMBRE=aeris

# Clave secreta para firmar los tokens de sesión y de recuperación.
# Pon un texto largo y aleatorio. Si cambia, todas las sesiones se cierran.
CLAVE_TOKENS=

# Horas sin datos para que un nodo pase a inactivo (T022). De 1 a 168.
# Si no se pone, 24. Para cambiarlo, edita el .env y reinicia el servidor.
# UMBRAL_INACTIVO_HORAS=24

# Página de la web que abre el enlace de recuperación de contraseña
URL_RESTABLECER=http://localhost:8080/restablecer.html

# Dirección de los botones del correo de vinculación del sensor (T005). Es opcional:
# si no se pone, se usa el mismo servidor que URL_RESTABLECER + /responderVinculacion.
# Con localhost, el correo hay que abrirlo en el mismo ordenador que el servidor.
# URL_VINCULACION=http://localhost:8080/responderVinculacion

# Correo (SMTP) para enviar el enlace de recuperar contraseña.
# Si SMTP_HOST está vacío, el enlace se muestra en la consola del servidor
# en lugar de enviarse (útil para probar en local).
#
# Con Gmail (cuenta del equipo con verificación en dos pasos):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PUERTO=587
#   SMTP_USUARIO=cuenta@gmail.com
#   SMTP_CONTRASENYA=<contraseña de aplicación de 16 letras, NO la de la cuenta>
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENYA=
# Opcional; si se deja vacío se usa "AERIS <SMTP_USUARIO>"
SMTP_REMITENTE=
